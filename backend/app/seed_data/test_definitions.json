[
  {
    "test_id": "TEST-VM-PAM-LOCKOUT-T1",
    "policy_code": "POL-IAM-001",
    "tier": 1,
    "is_required": true,
    "is_behavioral": false,
    "target_type": "LINUX_VM",
    "name": "Linux PAM faillock Configuration Inspection",
    "description": "Inspects /etc/security/faillock.conf or /etc/pam.d/common-auth to verify deny <= 5 and unlock_time >= 900.",
    "max_ttl_hours": 24,
    "test_spec": {
      "type": "ssh_command",
      "command": "grep -E '^\\s*deny\\s*=\\s*[1-5]' /etc/security/faillock.conf || grep -E 'pam_faillock.so.*deny=[1-5]' /etc/pam.d/common-auth",
      "expected_exit_code": 0,
      "expected_regex": "deny=[1-5]"
    }
  },
  {
    "test_id": "TEST-VM-PAM-LOCKOUT-T2",
    "policy_code": "POL-IAM-001",
    "tier": 2,
    "is_required": true,
    "is_behavioral": true,
    "target_type": "LINUX_VM",
    "name": "Linux Active SSH Account Lockout Probe",
    "description": "Actively executes 6 consecutive invalid SSH login attempts against a canary user account to verify that attempt #6 is locked.",
    "max_ttl_hours": 12,
    "test_spec": {
      "type": "ssh_behavioral_probe",
      "probe_action": "simulate_failed_logins",
      "target_user": "audit_canary",
      "attempt_count": 6,
      "expected_lockout_trigger": true
    }
  },
