# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.hostname = "cac-target-linux"

  # Static private network IP matching backend/app/config.py
  config.vm.network "private_network", ip: "192.168.56.101"

  # Forwarded ports for direct access
  config.vm.network "forwarded_port", guest: 22, host: 2220, id: "ssh"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "cac-target-linux"
    vb.memory = "2048"
    vb.cpus = 2
  end

  # Run bootstrap shell script automatically
  config.vm.provision "shell", path: "bootstrap.sh"
end
