# =============================================================================
# CAC-GRC Environment Configuration Template (.env.example)
# Copy this file to '.env' in the project root and fill in local values.
# IMPORTANT: Never commit actual secret tokens, private keys, or passwords.
# =============================================================================

# Application Metadata
PROJECT_NAME="CAC-GRC Engine"
API_V1_STR="/api/v1"

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql://user:pass@host:5432/cac_grc
DATABASE_URL="sqlite:///./cac_grc.db"

# Authentication & Role-Based Access Control (RBAC)
# Set AUTH_ENABLED=true for production & audit integrity (fails closed if tokens missing)
AUTH_ENABLED=true

# Role Bearer Tokens (Generate strong random alphanumeric strings for each role)
# Admin: Full control (chaos drift injection, baseline restoration, ledger checkpointing)
CAC_ADMIN_TOKEN="change-me-to-a-secure-admin-token"

# Engineer: Run automated CaC assessments, re-evaluate scores, manage finding lifecycle
CAC_ENGINEER_TOKEN="change-me-to-a-secure-engineer-token"

# Auditor: Read-only access to policies, controls, evidence ledger, and assurance reports
CAC_AUDITOR_TOKEN="change-me-to-a-secure-auditor-token"

# CORS Security Allowed Origins (JSON array format)
CORS_ALLOWED_ORIGINS='["http://localhost:8000","http://127.0.0.1:8000"]'

# Target 1: Linux VM Lab Connection Settings
LINUX_VM_HOST="192.168.56.101"
LINUX_VM_PORT=22
LINUX_VM_USER="auditor"
LINUX_VM_KEY_PATH=""
LINUX_VM_PASSWORD="example-lab-password"
SSH_KNOWN_HOSTS_FILE="lab/vm-setup/known_hosts"
SSH_STRICT_HOST_KEY_CHECKING=true

# Target 2: Target PostgreSQL Lab Container Settings
TARGET_DB_HOST="localhost"
TARGET_DB_PORT=5433
TARGET_DB_USER="postgres"
TARGET_DB_PASSWORD="example-lab-postgres-password"
TARGET_DB_NAME="enterprisedb"

# Target 3: Target Gitea VCS Lab Container Settings
TARGET_GITEA_URL="http://localhost:3000"
TARGET_GITEA_TOKEN="example-lab-gitea-token"

# Stage D1: External Ledger Integrity & Asymmetric Checkpointing
LEDGER_ID="CAC-GRC-PRIMARY-LEDGER"
LEDGER_SIGNING_KEY_PATH="keys/ledger_ed25519_private.pem"
LEDGER_VERIFY_KEY_PATH="keys/ledger_ed25519_public.pem"
